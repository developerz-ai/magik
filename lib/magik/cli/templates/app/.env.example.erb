# <%= app_title %> — example environment. Committed. Contains no real values, ever.
#
# ############################################################################
# # NOTHING READS THIS FILE YET.                                             #
# #                                                                          #
# # Magik <%= magik_version %> is spec only: there is no config loader, no boot process   #
# # and no database connection. Every variable below is the NAME and DEFAULT  #
# # the framework will read once Phase 1 lands. Copying this to `.env`        #
# # changes no behaviour, because no code looks it up. Status: planned.       #
# #                                                                          #
# # `.env` IS FOR DEVELOPMENT ONLY. PRODUCTION NEVER READS IT.                #
# #                                                                          #
# #   development   .env, loaded from the working directory. Convenience.     #
# #   any env       config/credentials.yml.enc — encrypted, COMMITTED,        #
# #                 decrypted with config/master.key (never committed) or     #
# #                 with MAGIK_MASTER_KEY from the environment.               #
# #   production    real environment variables set by the platform, plus the  #
# #                 encrypted credentials. No .env file is read at all.       #
# #                                                                          #
# # `.env`, `.env.local`, `.env.*.local` and `config/master.key` are          #
# # gitignored and MUST STAY gitignored. If you are editing `.gitignore` to   #
# # commit one of them, stop. This file is the only committed one, and it     #
# # holds names and blanks — never values.                                    #
# #                                                                          #
# # The full model:                                                          #
# # https://github.com/developerz-ai/magik/blob/main/docs/architecture/       #
# #   07-configuration-and-secrets.md                                        #
# ############################################################################
#
# A new variable ships with its line here in the SAME change that reads it. An
# env var is a contract; a key that exists only in someone's shell is a boot
# failure waiting for a deploy.
#
# Usage, once Phase 1 lands:
#   cp .env.example .env          # bin/setup does this for you, and never overwrites

# --- Application -----------------------------------------------------------

# Which environment the app boots as. development | test | production.
# Production additionally turns the boot-time guardrails into hard failures
# rather than warnings.
# Default: development
MAGIK_ENV=development

# Port the Puma-backed `magik server` binds.
# Default: 3000. In production most platforms inject $PORT.
PORT=3000

# --- Secrets ---------------------------------------------------------------
#
# Nothing in this section has a default, deliberately. An app that boots with a
# fallback secret is an app that ships with one. `magik new` does not generate a
# value here: a secret written by a generator is a secret in your git history.

# Signing key from which cookie and session keys are derived. >= 64 chars.
# Generate one with: ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
SECRET_KEY_BASE=

# The key that decrypts config/credentials.yml.enc. Exactly one of two sources
# supplies it: config/master.key (a gitignored file, the local default) or this
# variable (how production supplies it, because a container should carry no key
# file on disk). If both are present the environment variable wins.
MAGIK_MASTER_KEY=

# --- Data ------------------------------------------------------------------

# Sequel connection string for the primary database. Postgres is the default and
# the engine with the full swap-point implementation planned for Phase 1 —
# UUIDv7 keys, LISTEN/NOTIFY realtime, the transactional job queue.
# It is a credential: in production it comes from the platform, not from a file.
DATABASE_URL=<%= database_url %>

# Redis connection string. Only read when a backend below is switched to
# :redis — Redis is the documented ALTERNATIVE, never the default.
REDIS_URL=redis://localhost:6379/0

# --- Logging ---------------------------------------------------------------

# text | json. text for a terminal, json anywhere a log aggregator is reading.
# Default: text in development and test, json in production.
MAGIK_LOG_FORMAT=text

# debug | info | warn | error | fatal.
# Default: debug in development, info in production.
MAGIK_LOG_LEVEL=debug

# --- Swap points -----------------------------------------------------------
#
# Every opinionated default is switchable by config without touching app code.
# The default column is the opinionated choice; each line lists what else the
# framework commits to supporting. These are configuration, not secrets.

# memory | redis                                     Default: memory
MAGIK_CACHE_BACKEND=memory

# postgres | kafka                                   Default: postgres
# Postgres-backed and transactional, so a job enqueues inside the same
# transaction as the data it acts on and cannot outlive a rolled-back write.
MAGIK_JOBS_BACKEND=postgres

# postgres | redis                                   Default: postgres
# LISTEN/NOTIFY, so a single-database deployment needs no extra infrastructure
# to run realtime screens.
MAGIK_REALTIME_BACKEND=postgres

# postgres | pgvector | elasticsearch                Default: postgres
MAGIK_SEARCH_BACKEND=postgres

# --- <%= app_title %> ---------------------------------------------------------------
#
# Variables this app adds go below this line, each with a comment saying what
# reads it. `/setup-project` and `/feature` append here; the sections above are
# the framework's and are refreshed by `magik generate agents --update`.
