# CI for <%= app_title %>. Small on purpose: it runs `bin/check`, which is the
# same gate your pre-push hook runs, so local green and CI green mean the same
# thing. A check that lives only here cannot be run on a laptop, and one that
# lives only on a laptop does not gate.
#
# Generated by `magik new`. If you do not use GitHub, delete this file — nothing
# else references it. `magik new --no-ci` skips it.
#
# PROJECT-OWNED: no magik command rewrites this file.

name: CI

on:
  push:
    branches: [main]
  pull_request:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    name: bin/check
    runs-on: ubuntu-latest
    timeout-minutes: 15

    # Postgres is the default database, job queue and realtime backend all at
    # once — the same service docker/compose.yml starts locally.
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: <%= app_name %>
          POSTGRES_PASSWORD: <%= app_name %>
          POSTGRES_DB: <%= app_name %>_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U <%= app_name %>"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10

    env:
      MAGIK_ENV: test
      DATABASE_URL: postgres://<%= app_name %>:<%= app_name %>@localhost:5432/<%= app_name %>_test
      # CI has no .env. A real secret comes from repository secrets; this is a
      # throwaway for a database nobody keeps.
      SECRET_KEY_BASE: ci-only-not-a-secret-${{ github.run_id }}

    steps:
      - uses: actions/checkout@v4

      - uses: ruby/setup-ruby@v1
        with:
          ruby-version: "<%= ruby_version %>"
          bundler-cache: true

      # THE gate, and the whole job. It runs lint, the test suite, `magik check`
      # and every rule in scripts/checks/. Its exit code is the contract:
      #   0 green · 1 this app is wrong · 69 a tool is missing or a magik
      #   command is not implemented yet.
      #
      # 69 is NOT a failure: while magik is spec only, `magik check` and
      # `magik test` are `planned` and report MISSING. Turn this into a plain
      # `./bin/check` the day they run — the line below is the only thing
      # standing between this workflow and a real gate.
      - name: bin/check
        run: |
          set +e
          ./bin/check
          status=$?
          set -e
          if [ "$status" -eq 69 ]; then
            echo "::warning::bin/check exited 69 — a tool is missing or a magik command is not implemented yet."
            exit 0
          fi
          exit "$status"
