{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bin/check:*)",
      "Bash(bin/setup:*)",
      "Bash(bin/dev:*)",
      "Bash(bin/console:*)",
      "Bash(rake:*)",
      "Bash(bundle exec:*)",
      "Bash(bundle install)",
      "Bash(ruby -Ilib:*)",
      "Bash(ruby -ryaml:*)",
      "Bash(ruby -rjson:*)",
      "Bash(rubocop:*)",
      "Bash(yard:*)",
      "Bash(gem build:*)",
      "Bash(gem list:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue list:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(gem push:*)",
      "Bash(gem signin:*)",
      "Bash(gem yank:*)",
      "Bash(bin/release:*)",
      "Bash(gh release create:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --tags:*)",
      "Bash(git reset --hard:*)",
      "Bash(git stash:*)",
      "Bash(rm -rf /*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"${CLAUDE_PROJECT_DIR:-.}\" || exit 0; [ -f Gemfile.lock ] || exit 0; for f in $CLAUDE_FILE_PATHS; do case \"$f\" in *.rb|*.rake|*.gemspec) bundle exec rubocop -a --force-exclusion \"$f\" >/dev/null 2>&1 ;; esac; done; exit 0'"
          }
        ]
      }
    ]
  }
}
