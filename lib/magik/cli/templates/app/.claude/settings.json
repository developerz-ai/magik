{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(magik version:*)",
      "Bash(magik help:*)",
      "Bash(magik docs:*)",
      "Bash(magik check:*)",
      "Bash(magik test:*)",
      "Bash(magik generate:*)",
      "Bash(magik console:*)",
      "Bash(magik server:*)",
      "Bash(magik worker:*)",
      "Bash(magik routes:*)",
      "Bash(magik domains:*)",
      "Bash(magik errors:*)",
      "Bash(magik db create:*)",
      "Bash(magik db migrate:*)",
      "Bash(magik db rollback:*)",
      "Bash(magik db seed:*)",
      "Bash(magik db schema:*)",
      "Bash(bin/setup:*)",
      "Bash(bin/check:*)",
      "Bash(bin/dev:*)",
      "Bash(bin/console:*)",
      "Bash(bin/test:*)",
      "Bash(bin/magik:*)",
      "Bash(rake:*)",
      "Bash(rubocop:*)",
      "Bash(bundle exec:*)",
      "Bash(lefthook:*)",
      "Bash(ruby scripts/checks/:*)",
      "Bash(ruby -c:*)",
      "Bash(docker compose:*)",
      "Bash(bundle install)",
      "Bash(bundle exec magik:*)",
      "Bash(ruby -Ilib:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "WebFetch(domain:github.com)"
    ],
    "deny": [
      "Bash(magik db drop:*)",
      "Bash(magik db reset:*)",
      "Bash(magik db truncate:*)",
      "Bash(dropdb:*)",
      "Bash(psql:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --tags:*)",
      "Bash(git reset --hard:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf /*)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(cat config/master.key)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/config/master.key)",
      "Read(**/config/credentials.yml.enc)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.*.local)",
      "Write(**/config/master.key)",
      "Write(**/config/credentials.yml.enc)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/config/master.key)",
      "Edit(**/config/credentials.yml.enc)",
      "Write(**/db/schema.rb)",
      "Edit(**/db/schema.rb)"
    ],
    "defaultMode": "acceptEdits"
  }
}
